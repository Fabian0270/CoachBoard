<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Entitlements for the hardened runtime. These only take effect once the app
    is signed with a Developer ID (see docs/CODE_SIGNING.md); they are harmless
    on the current unsigned builds.

    Electron's V8 needs JIT + writable/executable memory, and better-sqlite3 is
    an unsigned native .node addon, so library validation must be disabled for it
    to load under the hardened runtime.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
